# Server Environment Configuration
# Copy this file to .env or .env.local and populate with your production credentials.
# Note: Actual secrets must never be committed to source control.

# Discord Webhook Integration (Private Webhook URL)
# Generate via: Discord Server Settings -> Integrations -> Webhooks -> New Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
